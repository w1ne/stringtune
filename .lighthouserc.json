{
  "ci": {
    "collect": {
      "staticDistDir": "./stringtune/public",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/"
      ]
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "csp-xss": [
          "error",
          {
            "maxLength": 3
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
